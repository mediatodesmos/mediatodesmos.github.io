rules_version = '2';

// Media to Desmos: Firestore security rules.
// Each signed-in person can read and write only their own data under users/{their uid}/.
// Everything else is closed. Publish these in the Firebase console (see README.md in this folder).
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} and everything below it, such as users/{uid}/projects/{id}.
    // In rules version 2, {rest=**} also matches zero segments, so this covers the users/{uid} document itself.
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else, explicitly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
